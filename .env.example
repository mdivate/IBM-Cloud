# IBM watsonx.ai credentials — Writing Pulse AI Blogging Assistant
# Copy this file to .env and set your actual API key.
# NEVER commit .env to version control — it is git-ignored.

# IBM Cloud API Key (required)
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# IBM watsonx.ai Project ID
WATSONX_PROJECT_ID=280ea383-d47b-42ab-a981-b28f66296121

# Regional endpoint (Sydney)
WATSONX_ENDPOINT=https://au-syd.ml.cloud.ibm.com

# Primary model: IBM Granite 3.3 8B Instruct
# Fallback: meta-llama/llama-3-3-70b-instruct (automatic)
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
