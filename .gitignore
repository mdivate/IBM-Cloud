# ---------------------------------------------------------
# Writing Pulse — Agentic AI Blogging Assistant
# .gitignore
# ---------------------------------------------------------

# SECRETS — NEVER commit credentials
.env
*.env
.env.*
!.env.example

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
log/

# Streamlit
.streamlit/secrets.toml

# Jupyter
.ipynb_checkpoints
*.ipynb

# Temporary files
*.tmp
*.bak
*.orig
tmp/
temp/
